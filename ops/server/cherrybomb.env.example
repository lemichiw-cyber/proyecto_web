# ===================================================================
# cherrybomb.env — configuración del backend en el servidor Debian.
#
# Se instala en /etc/cherrybomb/cherrybomb.env con permisos 600:
#   sudo install -m 640 -o root -g cherrybomb ops/server/cherrybomb.env.example \
#       /etc/cherrybomb/cherrybomb.env
#   sudoedit /etc/cherrybomb/cherrybomb.env
#
# NUNCA subas este archivo al repositorio: contiene la clave de NVIDIA.
# ===================================================================

# Entorno del backend.
SAKURA_ENV=production
SAKURA_HOST=127.0.0.1
SAKURA_PORT=8000

# Origenes admitidos por CORS. En producción el frontend y la API están
# en el MISMO origen (nginx), así que no hace falta CORS: se deja sólo
# el propio dominio por si se sirve la PWA desde otro lugar.
SAKURA_CORS_ORIGINS=https://CHERRYBOMB_DOMAIN

# Cookie de sesión. Como el frontend y el backend comparten origen,
# SameSite=Lax alcanza (es el valor por defecto y el más restrictivo).
SAKURA_COOKIE_SAMESITE=lax
SAKURA_COOKIE_SECURE=1

# En el servidor NO se habilita el acceso desde localhost ni la cabecera
# Access-Control-Allow-Private-Network (no hay red privada detrás).
SAKURA_ALLOW_LOCAL_CORS=0

# nginx sirve la PWA; el backend sólo expone la API.
SAKURA_SERVE_APP=0

# Directorio de datos (cuentas y sesiones), fuera del repositorio.
SAKURA_DATA_DIR=/var/lib/cherrybomb

# Depuración: desactivada en producción.
SAKURA_DEBUG=0

# --- IA con NVIDIA NIM ---
# Clave personal: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-CAMBIAR_ESTA_CLAVE
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
