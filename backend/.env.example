# ============================================================
# Sakura Player — Backend (copiar a .env y ajustar)
# ============================================================

# Escucha del backend
SAKURA_HOST=127.0.0.1
SAKURA_PORT=8000

# Orígenes permitidos por CORS (separados por coma)
SAKURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YouTube Music — archivo de autenticación (NUNCA se commitea).
# Generarlo con:
#   python -c "from ytmusicapi import YTMusic; YTMusic().setup()"
# o, para OAuth:
#   python -c "from ytmusicapi import YTMusic; YTMusic(auth='oauth.json').setup()"
# Si no existe, el backend funciona en modo invitado (búsqueda y streaming).
YTMUSIC_AUTH_FILE=auth.json

# Modo invitado aunque exista auth.json (true/false)
YTMUSIC_ALLOW_ANONYMOUS=true
