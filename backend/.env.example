# Configuracion OpenCode / Sakura Player - Backend
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.

SAKURA_ENV=production
SAKURA_HOST=127.0.0.1
SAKURA_PORT=8000
# Orígenes admitidos por CORS. REEMPLAZA la lista por defecto del backend:
# si la PWA se sirve desde GitHub Pages, acá va
# https://lemichiw-cyber.github.io
SAKURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://lemichiw-cyber.github.io
SAKURA_COOKIE_SECURE=1
# SameSite de la cookie de sesión:
#   lax    (default) → la cookie solo viaja al mismo origen que la app.
#   none             → necesario si el frontend (https) y el backend
#                      (http://127.0.0.1) están en sitios distintos, p.ej.
#                      GitHub Pages → backend local. Los navegadores exigen
#                      Secure junto con SameSite=None.
SAKURA_COOKIE_SAMESITE=lax
# Permite orígenes localhost y la cabecera Access-Control-Allow-Private-Network
# (Chrome la exige cuando una página pública llama a un servicio local).
SAKURA_ALLOW_LOCAL_CORS=0
# Sirve la PWA compilada (dist/) desde el propio backend:
#   http://127.0.0.1:8000/ → app y API en el mismo origen (sin CORS, sin
#   permiso de "acceso a la red local" y con la cookie normal).
# "auto" (por defecto) sirve la PWA sólo si existe dist/index.html.
SAKURA_SERVE_APP=auto
SAKURA_DEBUG=0

# IA con NVIDIA NIM (obtén tu clave en https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-TU_CLAVE_AQUI
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
