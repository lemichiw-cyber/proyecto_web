# ============================================================
# Sakura Player — Backend (copiar a .env y ajustar)
# ============================================================

# Escucha del backend
SAKURA_HOST=127.0.0.1
SAKURA_PORT=8000

# Orígenes permitidos por CORS (separados por coma).
# Además de esta lista SIEMPRE se permite cualquier puerto local
# (localhost / 127.0.0.1 con cualquier puerto) y GitHub Pages:
# si el origen no está permitido, el navegador bloquea la petición y
# el reproductor muestra "Backend apagado o sin conexión".
SAKURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://lemichiw-cyber.github.io

# YouTube Music — archivo de autenticación (NUNCA se commitea).
# Generarlo con:
#   python -c "from ytmusicapi import YTMusic; YTMusic().setup()"
# o, para OAuth:
#   python -c "from ytmusicapi import YTMusic; YTMusic(auth='oauth.json').setup()"
# Si no existe, el backend funciona en modo invitado (búsqueda y streaming).
YTMUSIC_AUTH_FILE=auth.json

# Modo invitado aunque exista auth.json (true/false)
YTMUSIC_ALLOW_ANONYMOUS=true
