# Supabase (opcional — sin esto se usan las credenciales del proyecto INCOA)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon

# La app funciona en modo local (localStorage) si Supabase no está configurado

# Sakura Player — backend Python (FastAPI + ytmusicapi)
# Correr: cd backend && pip install -r requirements.txt && uvicorn main:app --reload
# El frontend espera el backend en http://127.0.0.1:8000 (cambiable en Ajustes del reproductor)

# Migración de dominio (para avisos de exportar/importar al cambiar de URL)
# Dominios del sitio antiguo (separados por coma). Ejemplo:
# VITE_LEGACY_ORIGINS=https://lemichiw-cyber.github.io,https://proyecto-web-2-bygl.onrender.com
# VITE_LEGACY_ORIGINS=
# URL del sitio nuevo (para mostrar en el aviso). Ejemplo:
# VITE_NEW_APP_URL=https://mi-app.netlify.app
# VITE_NEW_APP_URL=
